# Copy to .env and fill in. deploy.sh generates this file for you on a fresh VPS.
NODE_ENV=production
# Your domain, already pointing (A record) at this VPS. Caddy gets the HTTPS certificate for it.
DOMAIN=panel.example.com
PUBLIC_URL=https://panel.example.com
# Long random strings: openssl rand -hex 32
JWT_SECRET=
WEBHOOK_TOKEN=
# Password for the "admin" login, used only when the database is first created
ADMIN_PASSWORD=
# vobiz (1800 numbers, Plivo-style XML), plivo or twilio
PROVIDER=vobiz
UPI_ID=yourbusiness@upi
# What you pay per forwarded minute, both legs together (1800 on Vobiz/Edesy: about 1.00)
COST_PER_MIN=1.00
# Extra minutes after the bundle runs out: price per minute, and how many a client may run up before calls stop
OVERAGE_RATE=1
OVERAGE_CAP_MIN=500
